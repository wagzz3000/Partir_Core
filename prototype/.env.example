# Partir Core Environment Configuration
# Copy to .env and fill in values
# On production, remote_boot.sh auto-generates secrets from this template.

# ─────────────────────────────────────────────────────────────
# Database (Required)
# ─────────────────────────────────────────────────────────────
PARTIR_DB_NAME=partir
PARTIR_DB_USER=partir
PARTIR_DB_PASSWORD=changeme_db_password
PARTIR_DB_URL=postgres://partir:changeme_db_password@127.0.0.1:5432/partir?sslmode=disable

# ─────────────────────────────────────────────────────────────
# MinIO / S3 Storage (Required)
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=partir
MINIO_ROOT_PASSWORD=changeme_minio_password
PARTIR_MINIO_ENDPOINT=127.0.0.1:9000
PARTIR_MINIO_ACCESS_KEY=partir
PARTIR_MINIO_SECRET_KEY=changeme_minio_password
PARTIR_MINIO_BUCKET=partir-artifacts

# ─────────────────────────────────────────────────────────────
# NATS (Required for factory workers)
# ─────────────────────────────────────────────────────────────
NATS_URL=nats://127.0.0.1:4222

# ─────────────────────────────────────────────────────────────
# Security (Required)
# ─────────────────────────────────────────────────────────────
PARTIR_JWT_SECRET=changeme_jwt_secret
PARTIR_ADMIN_USER=admin
PARTIR_ADMIN_PASS=admin

# ─────────────────────────────────────────────────────────────
# Observability (Required for production)
# ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4318
PARTIR_ENV=production
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────
# Executor Plugins (Optional - configure via `partir executors add`)
# ─────────────────────────────────────────────────────────────
# PARTIR_EXECUTOR_OLLAMA_URL=http://127.0.0.1:8081
# PARTIR_EXECUTOR_HELICONE_URL=http://127.0.0.1:8082
HELICONE_API_KEY=changeme_helicone_key
