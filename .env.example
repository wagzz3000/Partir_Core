# Partir Core Environment Configuration
# Copy to .env and fill in values

# ─────────────────────────────────────────────────────────────
# Database (Required)
# ─────────────────────────────────────────────────────────────
PARTIR_DB_NAME=partir
PARTIR_DB_USER=partir
PARTIR_DB_PASSWORD=changeme_strong_password_here
PARTIR_DB_URL=postgres://partir:changeme_strong_password_here@localhost:5432/partir?sslmode=disable

# ─────────────────────────────────────────────────────────────
# MinIO / S3 Storage (Required)
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=partir
MINIO_ROOT_PASSWORD=changeme_minio_password_here
PARTIR_MINIO_ENDPOINT=localhost:9000
PARTIR_MINIO_ACCESS_KEY=partir
PARTIR_MINIO_SECRET_KEY=changeme_minio_password_here
PARTIR_MINIO_BUCKET=partir-artifacts

# ─────────────────────────────────────────────────────────────
# Observability (Required for production)
# ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
PARTIR_ENV=production
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
GRAFANA_ROOT_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Optional: Disable telemetry for local dev
# ─────────────────────────────────────────────────────────────
# PARTIR_TELEMETRY_DISABLED=true

# ─────────────────────────────────────────────────────────────
# Executor Plugins (Optional - configure via `partir executors add`)
# ─────────────────────────────────────────────────────────────
# PARTIR_EXECUTOR_OLLAMA_URL=http://localhost:8081
# PARTIR_EXECUTOR_HELICONE_URL=http://localhost:8082
